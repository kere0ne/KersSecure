generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String          @id @default(cuid())
  discordId   String          @unique
  discordName String
  avatar      String?
  email       String?
  role        String          @default("CUSTOMER")
  suspended   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  projects    Project[]
  memberships ProjectMember[]
  licenses    License[]
  authLogs    AuthLog[]
  auditLogs   AuditLog[]
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String?
  ownerId     String
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  scripts     Script[]
  members     ProjectMember[]
  licenses    License[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  userId    String
  role      String  @default("DEVELOPER")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Script {
  id         String          @id @default(cuid())
  publicId   String          @unique @default(cuid())
  name       String
  filename   String?
  storageKey String?
  code       String?
  status     String          @default("DRAFT")
  version    Int             @default(1)
  projectId  String
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions   ScriptVersion[]
  executions ExecutionLog[]
  builds     Build[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model ScriptVersion {
  id        String   @id @default(cuid())
  scriptId  String
  storageKey String
  version   Int
  checksum  String
  createdAt DateTime @default(now())
  script    Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@unique([scriptId, version])
}

model License {
  id          String        @id @default(cuid())
  keyHash     String        @unique
  keyPrefix   String
  robloxUserId String?
  deviceHash  String?
  maxDevices  Int           @default(1)
  devices     String        @default("[]")
  status      String        @default("ACTIVE")
  expiresAt   DateTime?
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  discordId   String?
  usedCount   Int           @default(0)
  execLimit   Int?
  banned      Boolean       @default(false)
  note        String?
  batchId     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AuthLog {
  id        String   @id @default(cuid())
  scriptId  String?
  licenseId String?
  ipHash    String?
  outcome   String
  detail    String?
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ExecutionLog {
  id        String   @id @default(cuid())
  scriptId  String
  script    Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  licenseId String?
  outcome   String
  ipHash    String?
  createdAt DateTime @default(now())
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  plan             String
  status           String
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  metadata  String?
  createdAt DateTime @default(now())
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model GuildConfig {
  id              String   @id @default(cuid())
  guildId         String   @unique
  name            String?
  adminRoles      String   @default("[]")
  staffRoles      String   @default("[]")
  buyerRole       String?
  premiumRole     String?
  logChannel      String?
  verifyChannel   String?
  ticketChannel   String?
  welcomeChannel  String?
  announceChannel String?
  welcomeMessage  String?
  redeemSettings  String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(cuid())
  guildId   String
  channelId String?
  content   String
  createdBy String?
  createdAt DateTime @default(now())
}

model Build {
  id         String   @id @default(cuid())
  scriptId   String
  script     Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  code       String
  preset     String   @default("balanced")
  sizeBefore Int      @default(0)
  sizeAfter  Int      @default(0)
  checksum   String
  duration   Int      @default(0)
  createdAt  DateTime @default(now())
}
